# Copy to .env.local. Never commit .env.local.

# THERE ARE TWO MODE SWITCHES AND BOTH MUST BE SET. Getting one right is the failure mode:
# with the server vars set but VITE_LLM_MODE missing, /api/profile answers correctly to curl
# while the browser never calls it and every visitor sees the recorded bakery fixture.
#
#   LLM_MODE       server-side, read at request time by api/_lib/llm.ts
#   VITE_LLM_MODE  client-side, BAKED IN AT BUILD TIME — changing it needs a redeploy
#
# On Vercel, all of these must exist for Production (and Preview, if you demo preview links):
#   LLM_MODE  LLM_MODEL  LLM_API_KEY  VITE_LLM_MODE  DOMSCAN_API_KEY

# replay | live
# replay serves fixtures from src/data/replay with no network. This is the demo default.
LLM_MODE=replay

# Exact model ID from the Ignite-provided LLM plan. Left blank on purpose —
# do not hardcode a model string anywhere else in the repo.
#
# Use gpt-5.6-luna for the profile step. Measured against gpt-5.6-terra on the same
# inputs it returns the same industry, headcount, stem and mailboxes, for a tenth of
# the price ($0.2/$1.2 per 1M tokens vs $2/$12). At ~950 in / ~220 out per call that
# is roughly $0.0005 a call — about 30,000 calls inside a $15 budget, against ~3,300
# on terra. Switch to terra only if profile quality visibly drops.
LLM_MODEL=gpt-5.6-luna

LLM_API_KEY=
# Only set if Ignite gives us a gateway rather than the vendor endpoint.
LLM_BASE_URL=

# Client-side twin of LLM_MODE. Build-time, so a change needs a rebuild, not a restart.
VITE_LLM_MODE=replay

# Vercel share token for the demo bookmarklet, used ONLY by tools/bookmarklet/build.mjs.
# Not read by the app. Take it from the ?_vercel_share=... on a protected deployment link.
# It lived as a literal in source.js until 03 Sep, which put it in the repo — a tracked file
# cannot hold a secret whatever .gitignore says about the file it generates.
VERCEL_SHARE_TOKEN=

# Where the "continue to purchase" CTA hands off to.
# Staging is the only isolated tier. Preprod uses LIVE Stripe keys — never point here.
VITE_HANDOFF_BASE=https://join-staging.neo.space


# Neo's own check for whether a `.co.site` subdomain is already taken. OPTIONAL, and the
# reveal is honest without it — but wire it before trusting a green "Available" badge on a
# .co.site name.
#
# `.co.site` is Neo's namespace, so DomScan cannot answer for it: DomScan checks
# REGISTRATIONS, and `foo.co.site` is a record inside a domain Neo already owns. Asking it
# returns the answer for `co.site` itself, which is registered — a confident "taken" for
# every stem. Hence a separate upstream.
#
# Unset (the default): api/_lib/cositeService.ts falls back to an HTTP probe of
# https://<stem>.co.site/. That can prove a name is TAKEN (200) but never that it is free —
# `*.co.site` is a DNS wildcard, and an unpublished-but-claimed name 404s exactly like an
# unclaimed one. The probe therefore answers "unknown", which renders no badge. The reveal
# still recommends the name and still shows it as free; it just does not claim availability.
#
# Set it and that becomes a real yes/no. May contain {stem} or {domain}; with neither, the
# domain is appended as ?domain=. Response is read from available / isAvailable / taken /
# exists, whichever is present.
NEO_COSITE_CHECK_URL=https://bll.titan.email/internal/neo/check-domain-availability?domainName={domain}

# The check sits behind Titan's Partner Panel auth, which is a TWO-STEP flow:
#
#   1. POST https://api.titan.email/fa/mail/login
#        Content-Type: application/json
#        origin: https://app.titan.email          <- REQUIRED, not decoration
#        { email, password, device: "browser", iid, rp: { brand: "Titan" } }
#      -> { "session": "eyJhbGciOi...", "status": "success" }
#
#   2. GET https://bll.titan.email/internal/neo/v2/check-domain-availability
#        x-auth-token: <that session>             <- NOT Authorization: Bearer
#
# The mint credential is a real Titan LOGIN, email and password, not an API key. Put it in
# .env.local and in Vercel's env, never in a file that gets committed and never in a chat
# window. Neither value is logged, echoed into an error, or returned to the browser: a failed
# login raises the status code only, because the body of a rejected auth response can contain
# what it rejected.
#
# The session is a JWT, and its own `exp` claim sets the cache lifetime — the login response
# carries no expiresIn. Re-minting per request would be a credential-stuffing traffic shape
# against Titan's own auth endpoint, which is the real reason the cache exists.
#
# ┌──────────────────────────────────────────────────────────────────────────────────────────┐
# │ THE PATH HAS NO `v2`, AND THE PARAMETER IS `domainName`.                                 │
# │ Both were recovered from bll's own error codes on 2026-09-03:                            │
# │   /internal/neo/v2/check-domain-availability -> 404 UnRegisteredEndpoint (no such route)  │
# │   /internal/neo/check-domain-availability    -> 400 BAD_REQUEST (route EXISTS), whose     │
# │       body says "domainName or domainNames is required"                                  │
# │ `domainNames` implies batch support — worth using later to check the whole reveal in one  │
# │ call instead of one per stem.                                                            │
# │                                                                                          │
# │ IT STILL CANNOT ANSWER FROM OUTSIDE TITAN'S NETWORK. With the right path, the right      │
# │ parameter and a real session, every domain returns                                       │
# │   {"code":"NOT_FOUND","desc":"Hosting server not found"}                                 │
# │ — including titan.email and neo.space, which certainly exist. That is a blanket           │
# │ downstream failure, NOT an availability answer, and must never be read as "free". A       │
# │ garbage Authorization value returns the identical response, so this edge is not           │
# │ validating credentials: we are reaching the service past its gateway and nothing it says  │
# │ here is trustworthy. Resolve the routing before expecting a green badge; the ladder in    │
# │ cositeService.ts degrades all of it to the HTTP probe, so the reveal is correct meanwhile.│
# │                                                                                          │
# │ The fallback is a POOR substitute, not a near-equivalent. Titan confirmed an unpublished  │
# │ site still exists as an ACTIVE ORDER, so its name is taken — but the probe only sees      │
# │ PUBLISHED sites, and only 9,121 of 44,581 orders were ever published. It therefore misses │
# │ about four in five taken names, which is why it may only ever answer "taken" or           │
# │ "unknown", never "free".                                                                  │
# └──────────────────────────────────────────────────────────────────────────────────────────┘
#
# NEO_COSITE_CHECK_URL's `domain` query parameter is a GUESS — Titan supplied the path but not
# the parameter name. Set the full template here rather than relying on the default.
NEO_COSITE_TOKEN_URL=https://api.titan.email/fa/mail/login
NEO_PARTNER_EMAIL=
NEO_PARTNER_PASSWORD=
# Defaults are correct for Titan; override only if a deployment differs.
NEO_PARTNER_ORIGIN=
NEO_PARTNER_IID=
NEO_COSITE_AUTH_HEADER=

# Alternative to logging in: a long-lived session for a check endpoint that needs no login
# exchange. When set it is used as-is and nothing is minted. Leave blank to use the flow above.
NEO_COSITE_CHECK_TOKEN=

# Titan Support session for the Partner Panel bundle lookup — the ONLY source that can
# currently say a `.co.site` name is FREE. The probe can only ever say "taken".
#
#   GET https://api.flockmail.com/partner-panel/bundle/list?query=<domain>
#       x-auth-token: <this>
#   200 = an order holds the name · 404 = none does
#
# Reached ONLY from the manual "check a domain I typed" path. The reveal's own batch lookup,
# which fires on every page view, never touches it.
#
# ┌──────────────────────────────────────────────────────────────────────────────────────────┐
# │ THIS IS AN ADMIN SESSION, AND `manual=1` IS NOT A SECURITY BOUNDARY.                     │
# │ The client sets that flag, so anyone can. What the flag buys is that page views do not    │
# │ hit this endpoint — volume, not access. The real brake is PANEL_MAX_PER_WINDOW in         │
# │ cositeService.ts (30 calls per instance per 10 min) plus the per-domain cache.            │
# │                                                                                          │
# │ Only the STATUS CODE is read, never the body: a 200 carries the customer's email, name,   │
# │ customerId and order history, and there is no res.json() in that function. Do not add one.│
# │                                                                                          │
# │ Leave this BLANK unless you are demoing. Unset, the manual path falls back to the probe   │
# │ and the app is honest rather than wrong. The proper fixes are Titan-side: a working       │
# │ /internal/neo/check-domain-availability (purpose-built, returns no customer data) or a    │
# │ scoped service credential. See docs/bll-access-request.md.                                │
# └──────────────────────────────────────────────────────────────────────────────────────────┘
#
# To get one: log in to admin.titan.email, DevTools -> Network, click any partner-panel/*
# request, copy its x-auth-token. It expires; when it does the manual path returns "unknown"
# rather than guessing. `tools/cosite-check.mjs` does the same lookup from the terminal.
NEO_PARTNER_SESSION=
# Defaults are correct for production; override only for staging.
NEO_PARTNER_PANEL_URL=
NEO_PARTNER_PANEL_UA=

# Vercel share token for the demo bookmarklet, used ONLY by tools/bookmarklet/build.mjs.
# Not read by the app. Take it from the ?_vercel_share=... on a protected deployment link.
# It lived as a literal in source.js until 03 Sep, which put it in the repo — a tracked file
# cannot hold a secret whatever .gitignore says about the file it generates.
VERCEL_SHARE_TOKEN=

# Where the "continue to purchase" CTA hands off to.
# Staging is the only isolated tier. Preprod uses LIVE Stripe keys — never point here.
VITE_HANDOFF_BASE=https://join-staging.neo.space
