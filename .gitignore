# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# .env.local holds the Vercel OIDC token and, in live mode, the LLM API key.
# .env* is deliberately broad — .env.example is force-added and is the only one tracked.
.env*
!.env.example
.vercel

# Capture artifacts from walking Neo's live flows: screen recordings and HARs.
# Kept local on purpose — recordings show the tester's email and signup, and HARs
# contain session cookies and auth tokens. Findings belong in docs/neo-product-facts.md;
# the raw captures do not belong in the repo (they are also ~100MB).
neo_flows/
*.har
*.webm

# Bookmarklet output embeds the Vercel share token — keep it local.
tools/bookmarklet/bookmarklet.txt

# Raw source data — real customer records. Never commit.
analysis/data/
analysis/.venv/

# Per-run records written by the dev server. Contain business descriptions people typed.
runs.jsonl
